{
  "description": "Repository-local ChatGPT assignment pickup and conservative completion supervision.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/session-start.cjs\"",
            "commandWindows": "powershell -NoProfile -Command \"node (Join-Path (git rev-parse --show-toplevel) '.codex/hooks/session-start.cjs')\"",
            "timeout": 5,
            "statusMessage": "Checking for ChatGPT assignments",
            "additionalContextLimit": 600
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/stop-guard.cjs\"",
            "commandWindows": "powershell -NoProfile -Command \"node (Join-Path (git rev-parse --show-toplevel) '.codex/hooks/stop-guard.cjs')\"",
            "timeout": 5,
            "statusMessage": "Checking active ChatGPT task state"
          }
        ]
      }
    ]
  }
}
